page {
    height: 100%;
    background: #18325f;
}
.crop{
  position: fixed;
  width: 100%;
  height: 100%;
  z-index: 999;
}
.crop-top{
  position: absolute;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: flex-start;
  top: 10px;
  left: 0;
  right: 0;
  bottom: 150px;
  z-index: 1;
}
.crop-bottom{
  position: absolute;
  bottom: 30px;
  height: 100px;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 14px;
  color: #ccc;
  z-index: 999;
}
.crop-bottomview-button {
  margin-top: 20px; 
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.crop-bottomview {
  position: absolute;
  bottom: 30px;
  height: 100px;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 14px;
  color: #ccc;
}
.crop-bottomview-button-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.crop-bottomview-button-item-image {
  width: 40px;
  height: 40px;
}

.crop-bottomview-button-item-text {
  font-size: 14px;
  margin-top: 10px;
  color: white;
}
.canvas{
  position: absolute;
  width: 200px;
  height: 200px;
  background: white;
  visibility:hidden;
  top: -2000px;
}
.bg {
    width: 100%;
    height: 100%;
}

.content {
    position: absolute;
    z-index: 2;
    top: 340rpx;
    width: 100%;
}

/* panel start */
.panel {
    width: 92%;
    margin: auto;
    background: rgba(255, 255, 255, 0.644);
    border-radius: 30rpx;
    box-sizing: border-box;
    margin-top: 40rpx;
    overflow: hidden;
    padding: 18px;
}

.panel .category-list {
    display: flex;
    margin-bottom: 24rpx;
}

.panel .category-list text {
    color: #4d4d4d;
    font-size: 30rpx;
    margin: 0 8rpx;
    transition: .1s ease;
}

.panel .category-list text.active {
    color: #18325f;
    font-weight: bolder;
}

.panel scroll-view {
    white-space: nowrap;
}

.panel scroll-view image {
    width: 100rpx;
    height: 100rpx;
    border-radius: 16rpx;
    box-shadow: 0 12rpx 16rpx -12rpx rgba(0, 0, 0, .1);
    border: 4rpx solid rgba(3, 3, 170, .05);
    margin-right: 10px;
}

.panel scroll-view image.active {
    border: 4rpx solid #18325f;
}
.panel scroll-view text {
  margin-right: 10px;
  color: #4d4d4d;
  font-size: 25rpx;
  margin-top: 5rpx;
  transition: .1s ease;
}

.panel scroll-view text.active {
  color: #18325f;
  font-weight: bolder;
}


/* btns */
.btns {
    width: 86%;
    margin: auto;
    display: flex;
    justify-content: space-between;
    margin-top: 50rpx;
}

.btns .left {
    width: 200rpx;
    height: 200rpx;
    position: relative;
}

.btns .left .avatar {
    position: absolute;
    left: 0;
    top: 0;
}

.btns .left .image {
    width: 200px;
    height: 200px;
    background-color: #fff;
}

.btns .left image {
    width: 100%;
    height: 100%;
}

.btns .right button.round {
    width: 70rpx;
    height: 70rpx;
    border-radius: 50%;
    padding: 0;
}

.btns .right button {
    width: 200rpx;
    font-weight: bolder;
    height: 68rpx;
    background: #fff;
    box-shadow: 5px 5px 5px 0px rgb(0, 0, 0);
    border-radius: 24rpx;
    color: #4d4d4d;
    font-size: 24rpx;
    margin: 40rpx 0;
    padding-left: 8rpx;
    padding-right: 8rpx;
    text-align: center;
}