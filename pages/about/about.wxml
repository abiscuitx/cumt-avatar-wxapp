<view class="pyqItem">
  <view>
    <image class="avatarStyle" src='../../static/about/ercode.jpg'></image>
  </view>
  <view class="pyq-right">
    <!-- 用户昵称 -->
    <view class="userNickNameStyle">矿大头像戳
    </view>
    <!-- 文本内容 -->
    <view class="pyqContentText" catchlongpress="showSelect">
      <text decode="{{true}}" user-select="true">&emsp;&emsp;希望同学们能通过各类主题、各种形式的头像框，体会矿大“努力努力、行健天同功”的自强不息精神，“守坚定、戒骄盈、忍劳苦”的艰苦奋斗精神，“于科学有真发明、于社会有真贡献”的追求卓越精神。</text>
    </view>
    <!-- 底部信息及按钮 -->
    <view class="bottomStyle">
      <!-- 发布日期 -->
      <view class="center">
        <yy-date-item>
          <text class="bottomDateStyle">2023年7月31日 08:00</text>
        </yy-date-item>
      </view>
      <!-- 点赞/评论按钮 -->
      <view class="goodBtn" bindtap="showGoodCommentBtn">
        <view class="goodBtnDot"></view>
        <view class="goodBtnDot"></view>
      </view>
    </view>
    <view class="mypyqComment">
      <!-- 评论内容栏 -->
      <view class="commentContentStyle">
        <!-- 用户评论ITEM -->
        <view class="CommentItem">
          <!-- 评论用户信息 -->
          <view class="CommentItemRight">
            <!-- 评论信息栏 -->
            <view class="commentTop">
              <text class="commentNickName">2023迎新季制作团队：<text class="commentContentText">主办方：中国矿业大学学生会、中国矿业大学研究生会、矿大青年融媒体中心；协办方：各二级学院学生会；技术支持：中国矿业大学翔工作室。</text></text>

            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
<view class="line"></view>
<view class="pyqItem">
  <view>
